 {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "ECRAuth",
        "Effect": "Allow",
        "Action": [
          "ecr:GetAuthorizationToken"
        ],
        "Resource": "*"
      },
      {
        "Sid": "ECRPushImage",
        "Effect": "Allow",
        "Action": [
          "ecr:BatchCheckLayerAvailability",
          "ecr:InitiateLayerUpload",
          "ecr:UploadLayerPart",
          "ecr:CompleteLayerUpload",
          "ecr:PutImage"
        ],
        "Resource": "arn:aws:ecr:ap-south-1:000000000000:repository/my-app-repo"
      },
      {
        "Sid": "ECSDeployTaskDef",
        "Effect": "Allow",
        "Action": [
          "ecs:RegisterTaskDefinition",
          "ecs:DescribeTaskDefinition"
        ],
        "Resource": "*"
      },
      {
        "Sid": "ECSUpdateService",
        "Effect": "Allow",
        "Action": [
          "ecs:UpdateService",
          "ecs:DescribeServices"
        ],
        "Resource": "arn:aws:ecs:ap-south-1:000000000000:service/my-cluster/my-service"
      },
      {
        "Sid": "ECSPassRole",
        "Effect": "Allow",
        "Action": [
          "iam:PassRole"
        ],
        "Resource": [
          "arn:aws:iam::000000000000:role/ecsTaskExecutionRole",
          "arn:aws:iam::000000000000:role/ecsTaskRole"
        ]
      },
      {
        "Sid": "S3ReadArtifacts",
        "Effect": "Allow",
        "Action": [
          "s3:GetObject",
          "s3:ListBucket"
        ],
        "Resource": [
          "arn:aws:s3:::devops-assignment-app-bucket",
          "arn:aws:s3:::devops-assignment-app-bucket/*"
        ]
      }
    ]
  }
